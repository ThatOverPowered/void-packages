# Template file for 'scx-scheds'
pkgname=scx-scheds
version=1.1.3
revision=1
archs="x86_64"
wrksrc="scx"
build_style=cargo
hostmakedepends="git clang pkg-config elfutils-devel libseccomp-devel"
makedepends="libbpf-devel zlib-devel libzstd-devel libseccomp-devel openssl-devel"
short_desc="Sched_ext schedulers and tools"
maintainer="ThatOverPowered <thatoverpowered@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://github.com/sched-ext/scx"

make_check=no

do_fetch() {
	git clone --depth=1 https://github.com/sched-ext/scx "${wrksrc}"
}

pre_build() {
	export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
		   CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
		   LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
		   CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		   CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
		   LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
		   CFLAGS="" CXXFLAGS="" LDFLAGS=""
}

do_install() {
	find target/"${RUST_TARGET}"/release \
		! -path target/"${RUST_TARGET}"/release -prune \
		-type f -perm -0100 -name 'scx*' \
		! -name scx_arena_selftests \
		-exec install -Dm755 -t "${DESTDIR}"/usr/bin '{}' \+
}

post_install() {
	vlicense LICENSE
	vinstall "${FILESDIR}"/00-pseudofs-scx.sh 644 /etc/runit/core-services
}
